---
const { title = 'EduMondo', description = 'Un monde d’idées à partager !' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="fr-CA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title} | EduMondo</title>
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="shell header-inner">
      <a class="brand" href={`${base}/`} aria-label="EduMondo, accueil"><span class="brand-mark">🌎</span> Edu<span>Mondo</span></a>
      <nav aria-label="Navigation principale">
        <a href={`${base}/`}>Accueil</a>
        <a href={`${base}/activities/`}>Activités</a>
        <a href={`${base}/semaine/`}>Ma semaine</a>
        <a href={`${base}/#themes`}>Thématiques</a>
        <a class="nav-cta" href={`${base}/contribute/`}>Partager une idée ✨</a>
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer class="site-footer"><div class="shell footer-inner"><strong>🌎 EduMondo</strong><span>Un monde d'idées à partager !</span><span>© {new Date().getFullYear()} EduMondo</span></div></footer>
</body>
</html>
<style is:global>@import '../styles/global.css';</style>
